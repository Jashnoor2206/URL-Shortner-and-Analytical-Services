<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener</title>
    <link rel="stylesheet" href="/home.css">
</head>
<body>

    <div class="page">

        <div class="create-panel">
            <h1>URL Shortener</h1>
            <p class="subtitle">Paste a long URL, get a short one back.</p>

            <div class="input-row">
                <input type="text" id="longUrl" placeholder="https://example.com/some/very/long/link" />
                <button id="shortenBtn">Shorten</button>
            </div>

            <div class="result" id="result"></div>
        </div>

        <div class="list-panel">
            <h2>Your Links</h2>
            <div class="url-list">
                <% if (!urls) { %>
                    <p class="empty-state">No links yet — create your first one.</p>
                <% } else { %>
                    <% urls.forEach(function(entry) { %>
                        <div class="url-item">
                            <div class="url-item-top">
                                <a href="/<%= entry.shortID %>" target="_blank"><%= entry.shortID %></a>
                                <span class="click-count"><%= entry.visitHistory.length %> clicks</span>
                            </div>
                            <p class="original-url"><%= entry.redirectURL %></p>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>

    </div>

    <script>
        const btn = document.getElementById('shortenBtn');
        const input = document.getElementById('longUrl');
        const result = document.getElementById('result');

        btn.addEventListener('click', async () => {
            const url = input.value.trim();

            if (!url) {
                result.innerHTML = '<p class="error">Please enter a URL first.</p>';
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Shortening...';

            try {
                const response = await fetch('/url', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ url })
                });

                const data = await response.json();

                if (!response.ok) {
                    result.innerHTML = `<p class="error">${data.error || 'Something went wrong.'}</p>`;
                    btn.disabled = false;
                    btn.textContent = 'Shorten';
                    return;
                }

                result.innerHTML = '<p class="success">Link created! Refreshing your list...</p>';
                setTimeout(() => window.location.reload(), 600);

            } catch (err) {
                result.innerHTML = '<p class="error">Could not reach the server.</p>';
                btn.disabled = false;
                btn.textContent = 'Shorten';
            }
        });

        input.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') btn.click();
        });
    </script>

</body>
</html>